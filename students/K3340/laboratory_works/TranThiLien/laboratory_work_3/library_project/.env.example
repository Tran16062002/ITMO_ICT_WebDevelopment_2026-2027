# Скопируйте этот файл в .env и укажите свои значения
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=library_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# USE_SQLITE=1   # раскомментируйте, чтобы запустить без PostgreSQL (только для проверки)
